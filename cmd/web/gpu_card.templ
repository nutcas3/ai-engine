package web

import (
	"fmt"

	"ai-engine/internal/api"
)

// GPUCard renders a node card for the initial page load and htmx responses.
templ GPUCard(n api.Node) {
	<div id={ fmt.Sprintf("gpu-%s", n.ID) } class="bg-paper-white rounded-3xl p-6 relative flex flex-col justify-between transition-all">
		@gpuCardInner(n)
	</div>
}

// GPUCardOOB renders the same card tagged for an out-of-band swap, so a single
// SSE stream can patch any card already on the page by id.
templ GPUCardOOB(n api.Node) {
	<div id={ fmt.Sprintf("gpu-%s", n.ID) } hx-swap-oob="outerHTML" class="bg-paper-white rounded-3xl p-6 relative flex flex-col justify-between transition-all">
		@gpuCardInner(n)
	</div>
}

// GPUCardAppend renders a card tagged to be appended into the fleet grid,
// used when a newly provisioned node appears on the SSE stream.
templ GPUCardAppend(n api.Node) {
	<div hx-swap-oob="beforeend:#fleet-grid">
		@GPUCard(n)
	</div>
}

templ gpuCardInner(n api.Node) {
	<div>
		<div class="flex items-center justify-between mb-4">
			<div>
				<h4 class="font-display text-xl tracking-tight uppercase text-carbon-black">{ n.Name }</h4>
				<p class="text-xs text-smoke font-mono mt-1">{ n.Provider } · { n.GPU.Model }</p>
			</div>
			if n.Status() == "Ready" {
				<span class="px-3 py-1 rounded-full text-xs font-mono bg-mint-chip text-carbon-black">
					READY
				</span>
			} else if n.Status() == "Degraded" {
				<span class="px-3 py-1 rounded-full text-xs font-mono bg-voltage-yellow text-carbon-black">
					XID FAULT
				</span>
			} else {
				<span class="px-3 py-1 rounded-full text-xs font-mono bg-graphite text-paper-white">
					DRAINING
				</span>
			}
		</div>
		<div class="space-y-2 mt-5">
			<div class="flex justify-between text-xs font-mono text-smoke">
				<span>VRAM ALLOCATION</span>
				<span class="text-carbon-black">{ fmt.Sprintf("%.1f / %.1f GB", n.GPU.VRAMUsedGB, n.GPU.VRAMTotalGB) }</span>
			</div>
			<div class="w-full h-2.5 bg-mist-gray rounded-full overflow-hidden">
				<div class="h-full bg-carbon-black transition-all duration-500" style={ fmt.Sprintf("width: %.1f%%", (n.GPU.VRAMUsedGB/n.GPU.VRAMTotalGB)*100) }></div>
			</div>
		</div>
		<div class="grid grid-cols-2 gap-4 mt-5 pt-5 border-t border-ash text-xs">
			<div>
				<span class="text-smoke font-mono">COMPUTE LOAD</span>
				<p class="text-2xl font-display tracking-tight text-carbon-black mt-1">{ fmt.Sprintf("%d%%", n.GPU.Utilization) }</p>
			</div>
			<div>
				<span class="text-smoke font-mono">CORE TEMP</span>
				<p class="text-2xl font-display tracking-tight text-carbon-black mt-1">{ fmt.Sprintf("%d°C", n.GPU.TempC) }</p>
			</div>
		</div>
		if len(n.GPU.XidErrors) > 0 {
			<div class="mt-4">
				<span class="text-xs font-mono bg-voltage-yellow text-carbon-black px-2 py-0.5">
					Xid { fmt.Sprintf("%v", n.GPU.XidErrors) }
				</span>
			</div>
		}
	</div>
	<div class="mt-6 pt-4 border-t border-ash">
		if n.Status() == "Degraded" {
			<button
				hx-post={ fmt.Sprintf("/api/nodes/%s/drain", n.ID) }
				hx-target={ fmt.Sprintf("#gpu-%s", n.ID) }
				hx-swap="outerHTML"
				class="w-full py-2.5 px-4 bg-carbon-black hover:bg-graphite text-paper-white text-xs font-mono uppercase tracking-wide rounded-lg transition-colors"
			>
				Drain Node &amp; Replace
			</button>
		} else if n.Status() == "Draining" {
			<div class="text-center text-xs text-smoke font-mono py-1">
				TRIGGERING CAPI REPLACEMENT…
			</div>
		} else {
			<div class="flex justify-between items-center text-xs text-smoke font-mono">
				<span>VLLM ACTIVE</span>
				<span class="flex items-center gap-1.5">
					<span class="w-2 h-2 rounded-full bg-voltage-yellow"></span>
					HEALTHY
				</span>
			</div>
		}
	</div>
}
