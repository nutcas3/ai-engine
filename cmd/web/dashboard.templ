package web

import (
	"github.com/nutcas3/ai-engine/internal/api"
	"github.com/nutcas3/ai-engine/internal/providers"
)

templ Dashboard(nodes []api.Node, brand Brand) {
	@Base("Telemetry Dashboard", "overview", brand) {
		<div class="space-y-8 pt-4">
			<div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4">
				<div>
					<p class="text-caption font-geist-mono text-mid-gray mb-1.5">FLEET / TELEMETRY / LIVE</p>
					<h1 class="text-display font-semibold tracking-display text-ink">GPU Fleet Telemetry</h1>
					<p class="text-body text-mid-gray mt-2">Multi-cloud hardware health, VRAM utilization, and automated node remediation.</p>
				</div>
				<button
					hx-get="/api/clusters/provision"
					hx-target="#modal-container"
					class="px-4 py-2 bg-ink hover:bg-ink-soft text-paper font-medium text-body rounded-md transition-colors flex items-center justify-center gap-2 shrink-0"
				>
					<span>+</span> Provision Node Pool
				</button>
			</div>
			<div hx-ext="sse" sse-connect="/api/telemetry/stream" sse-swap="gpu-metrics">
				<div id="fleet-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
					for _, node := range nodes {
						@GPUCard(node)
					}
				</div>
			</div>
			<div id="modal-container"></div>
		</div>
	}
}

// ProvisionModal lets an operator pick an infrastructure adapter and node pool
// shape. Only providers reporting Ready can actually provision today.
templ ProvisionModal(providers []providers.Provider) {
	<div class="fixed inset-0 z-50 flex items-center justify-center bg-ink/40">
		<div class="bg-paper rounded-2xl shadow-subtle w-full max-w-md p-6">
			<div class="flex items-center justify-between mb-5">
				<h2 class="text-heading-sm font-semibold tracking-tight text-ink">Provision Pool</h2>
				<button hx-get="/api/clusters/provision/close" hx-target="#modal-container" class="w-7 h-7 rounded-md bg-surface-alt border border-hairline text-mid-gray hover:text-ink flex items-center justify-center leading-none">&times;</button>
			</div>
			<form hx-post="/api/nodePools" hx-target="#fleet-grid" hx-swap="beforeend" class="space-y-4">
				<div>
					<label class="block text-caption font-geist-mono text-mid-gray mb-1.5">INFRASTRUCTURE PROVIDER</label>
					<select name="provider" class="w-full bg-surface-alt border border-hairline rounded-md px-3 py-2 text-body text-ink focus:outline-none focus:ring-2 focus:ring-ink">
						for _, p := range providers {
							if p.Ready() {
								<option value={ p.Key() }>{ p.Display() }</option>
							} else {
								<option value={ p.Key() } disabled>{ p.Display() } — not configured</option>
							}
						}
					</select>
				</div>
				<div>
					<label class="block text-caption font-geist-mono text-mid-gray mb-1.5">POOL NAME</label>
					<input name="name" type="text" required placeholder="e.g. h100-inference-pool" class="w-full bg-surface-alt border border-hairline rounded-md px-3 py-2 text-body text-ink focus:outline-none focus:ring-2 focus:ring-ink"/>
				</div>
				<div class="grid grid-cols-2 gap-3">
					<div>
						<label class="block text-caption font-geist-mono text-mid-gray mb-1.5">GPU MODEL</label>
						<select name="gpu_model" class="w-full bg-surface-alt border border-hairline rounded-md px-3 py-2 text-body text-ink focus:outline-none focus:ring-2 focus:ring-ink">
							<option>NVIDIA H100 80GB</option>
							<option>NVIDIA A100 80GB</option>
							<option>NVIDIA L40S 48GB</option>
							<option>NVIDIA B200 180GB</option>
						</select>
					</div>
					<div>
						<label class="block text-caption font-geist-mono text-mid-gray mb-1.5">NODE COUNT</label>
						<input name="count" type="number" min="1" max="8" value="1" class="w-full bg-surface-alt border border-hairline rounded-md px-3 py-2 text-body text-ink focus:outline-none focus:ring-2 focus:ring-ink"/>
					</div>
				</div>
				<div class="pt-1 flex justify-end gap-2">
					<button type="button" hx-get="/api/clusters/provision/close" hx-target="#modal-container" class="px-3 py-2 text-body text-mid-gray hover:text-ink transition-colors">Cancel</button>
					<button type="submit" class="px-4 py-2 bg-ink hover:bg-ink-soft text-paper text-body font-medium rounded-md transition-colors">Provision via CAPI</button>
				</div>
			</form>
		</div>
	</div>
}
