package web

import (
	"ai-engine/internal/api"
	"ai-engine/internal/providers"
)

templ Dashboard(nodes []api.Node, brand Brand) {
	@Base("Telemetry Dashboard", brand) {
		<div class="space-y-10 pt-4">
			<div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4">
				<div>
					<p class="text-xs font-suisseintlmono text-smoke mb-2">FLEET / TELEMETRY / LIVE</p>
					<h1 class="font-suisseintlcond text-heading-lg md:text-display tracking-tight uppercase text-carbon-black">GPU Fleet<br/>Telemetry</h1>
					<p class="text-sm text-slate mt-3">Multi-cloud hardware health, VRAM utilization, and automated node remediation.</p>
				</div>
				<button
					hx-get="/api/clusters/provision"
					hx-target="#modal-container"
					class="px-6 py-3 bg-carbon-black hover:bg-graphite text-paper-white font-medium text-sm rounded-lg transition-all flex items-center justify-center gap-2 shrink-0"
				>
					<span>+</span> Provision Node Pool
				</button>
			</div>
			<div hx-ext="sse" sse-connect="/api/telemetry/stream" sse-swap="gpu-metrics">
				<div id="fleet-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
					for _, node := range nodes {
						@GPUCard(node)
					}
				</div>
			</div>
			<div id="modal-container"></div>
		</div>
	}
}

// ProvisionModal lets an operator pick an infrastructure adapter and node pool
// shape. Only providers reporting Ready can actually provision today.
templ ProvisionModal(providers []providers.Provider) {
	<div class="fixed inset-0 z-50 flex items-center justify-center bg-carbon-black/50">
		<div class="bg-paper-white rounded-[32px] w-full max-w-md p-8">
			<div class="flex items-center justify-between mb-6">
				<h2 class="font-display text-2xl tracking-tight uppercase text-carbon-black">Provision Pool</h2>
				<button hx-get="/api/clusters/provision/close" hx-target="#modal-container" class="w-8 h-8 rounded-full bg-mist-gray text-slate hover:bg-ash flex items-center justify-center text-lg leading-none">&times;</button>
			</div>
			<form hx-post="/api/nodePools" hx-target="#fleet-grid" hx-swap="beforeend" class="space-y-5">
				<div>
					<label class="block text-xs font-suisseintlmono text-smoke mb-2">INFRASTRUCTURE PROVIDER</label>
					<select name="provider" class="w-full bg-mist-gray rounded-lg px-4 py-3 text-sm text-carbon-black focus:outline-none focus:ring-2 focus:ring-carbon-black">
						for _, p := range providers {
							if p.Ready() {
								<option value={ p.Key() }>{ p.Display() }</option>
							} else {
								<option value={ p.Key() } disabled>{ p.Display() } — not configured</option>
							}
						}
					</select>
				</div>
				<div>
					<label class="block text-xs font-suisseintlmono text-smoke mb-2">POOL NAME</label>
					<input name="name" type="text" required placeholder="e.g. h100-inference-pool" class="w-full bg-mist-gray rounded-lg px-4 py-3 text-sm text-carbon-black focus:outline-none focus:ring-2 focus:ring-carbon-black"/>
				</div>
				<div class="grid grid-cols-2 gap-4">
					<div>
						<label class="block text-xs font-suisseintlmono text-smoke mb-2">GPU MODEL</label>
						<select name="gpu_model" class="w-full bg-mist-gray rounded-lg px-4 py-3 text-sm text-carbon-black focus:outline-none focus:ring-2 focus:ring-carbon-black">
							<option>NVIDIA H100 80GB</option>
							<option>NVIDIA A100 80GB</option>
							<option>NVIDIA L40S 48GB</option>
							<option>NVIDIA B200 180GB</option>
						</select>
					</div>
					<div>
						<label class="block text-xs font-suisseintlmono text-smoke mb-2">NODE COUNT</label>
						<input name="count" type="number" min="1" max="8" value="1" class="w-full bg-mist-gray rounded-lg px-4 py-3 text-sm text-carbon-black focus:outline-none focus:ring-2 focus:ring-carbon-black"/>
					</div>
				</div>
				<div class="pt-2 flex justify-end gap-3">
					<button type="button" hx-get="/api/clusters/provision/close" hx-target="#modal-container" class="px-4 py-2.5 text-sm text-slate hover:text-carbon-black transition-colors">Cancel</button>
					<button type="submit" class="px-5 py-2.5 bg-carbon-black hover:bg-graphite text-paper-white text-sm font-medium rounded-lg transition-colors">Provision via CAPI</button>
				</div>
			</form>
		</div>
	</div>
}
